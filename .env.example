# =====================================================================================================
# NqnTech Concursos — variáveis de ambiente
# Copie para .env (que NUNCA vai para o Git) e troque os valores. Todos os valores aqui são fictícios.
# O mesmo código roda nos dois ambientes; só mudam estes valores (.env local x GitHub Secrets).
# Atalho: python scripts/criar_env.py --email voce@exemplo.com  (gera senhas locais aleatórias)
# =====================================================================================================

# -----------------------------------------------------------------------------------------------------
# BLOCO 1 — DEV (Docker): lido pelo docker compose e pelas aplicações rodando na sua máquina
# -----------------------------------------------------------------------------------------------------

# Banco criado pelo contêiner postgres
POSTGRES_DB=concursos
# Usuário administrador local: só o Flyway e você (via psql/IDE) usam; as aplicações nunca
POSTGRES_USER=concursos_admin
# Senha do administrador local (troque; mínimo 16 caracteres)
POSTGRES_PASSWORD=troque-esta-senha-admin-local
# Porta do Postgres no seu PC (só 127.0.0.1); mude se a 5432 já estiver ocupada
POSTGRES_PORT=5432

# Porta SMTP do Mailpit no seu PC (captura os e-mails; nada sai para a internet) — usado na fase 7
MAILPIT_SMTP_PORT=1025
# Porta da interface web do Mailpit: http://127.0.0.1:8025
MAILPIT_UI_PORT=8025

# Conexão usada pelas aplicações (em dev, o Postgres do Docker)
DB_HOST=127.0.0.1
# Mesma porta de POSTGRES_PORT
DB_PORT=5432
# Mesmo nome de POSTGRES_DB
DB_NAME=concursos
# disable em dev (contêiner local); require em produção
DB_SSLMODE=disable

# Usuário do coletor (Python): grava só as tabelas de coleta
COLETOR_DB_USER=coletor_app
# Senha do coletor_app (o Flyway a recebe como placeholder ao criar o usuário)
COLETOR_DB_PASSWORD=troque-senha-coletor-local
# Usuário do gerador do site (Java, fase 5): só leitura do que é público
SITE_DB_USER=site_app
# Senha do site_app (também passada ao Flyway como placeholder)
SITE_DB_PASSWORD=troque-senha-site-local

# E-mail de contato publicado no User-Agent do coletor (os sites sabem quem acessa e como avisar)
COLETOR_CONTATO_EMAIL=voce@exemplo.com
# Limites por execução (opcionais; padrões no código)
# COLETOR_MAX_DOCUMENTOS=60
# COLETOR_MAX_PAGINAS=15
# COLETOR_MAX_PAGINAS_REALIZADOS=2
# COLETOR_INTERVALO_S=2.5

# -----------------------------------------------------------------------------------------------------
# BLOCO 2 — PRODUÇÃO (GitHub Secrets): NÃO preencha aqui. Cadastre em
# Settings → Secrets and variables → Actions (passo a passo em docs/PENDENCIAS.md).
# Mantido comentado só para documentar os nomes; o docker compose ignora linhas comentadas.
# -----------------------------------------------------------------------------------------------------

# String de conexão do Neon (dono do banco, SEM pooler). Usada só pelo migrar.yml; o diario.yml extrai
# dela apenas o host e o nome do banco.
# NEON_ADMIN_URL=postgresql://neondb_owner:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senhas dos usuários das aplicações (aleatórias, 24+ caracteres; o Neon exige 60+ bits de entropia)
# COLETOR_DB_PASSWORD=senha-aleatoria-longa
# SITE_DB_PASSWORD=outra-senha-aleatoria-longa

# Contato publicado no User-Agent do coletor
# COLETOR_CONTATO_EMAIL=voce@exemplo.com
