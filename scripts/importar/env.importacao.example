# Copie este arquivo para ".env" na RAIZ do repositório (ao lado de README.md) e preencha.
# O .env nunca vai para o Git. Os valores vêm do Neon e dos mesmos secrets do GitHub.

# Neon: host e banco da string de conexão (Neon → Connection details, SEM "-pooler" no host)
DB_HOST=ep-xxxx.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_SSLMODE=require

# Usuário do coletor (o mesmo do secret COLETOR_DB_PASSWORD; nunca use o dono do banco)
COLETOR_DB_USER=coletor_app
COLETOR_DB_PASSWORD=cole-aqui-a-senha-do-coletor_app
COLETOR_CONTATO_EMAIL=voce@exemplo.com

# IA (opcional, as mesmas chaves dos secrets): sem elas só as regras estruturam o edital
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
